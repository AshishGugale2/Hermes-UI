# Vite development proxy targets (server-side, never included in the browser).
API_PROXY_TARGET=http://localhost:8000
MAIL_PROXY_TARGET=http://localhost:8080

# Optional public build-time API base URL. Keep / for the same-origin proxy.
VITE_API_BASE_URL=/

# Nginx container routing and public runtime configuration.
API_UPSTREAM=http://host.docker.internal:8000
MAIL_UPSTREAM=http://host.docker.internal:8080
UI_API_BASE_URL=/
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=3000
